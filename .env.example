# Symmetrix - Environment Variables for Vercel
# Copy to .env.local for local development (vercel dev)
# Add these in Vercel Dashboard > Settings > Environment Variables

# Stripe (required for payments)
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_PUBLIC_KEY=replace_with_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret

# Stripe Price IDs (optional - create in Stripe Dashboard > Products)
# If not set, ad-hoc pricing will be used
STRIPE_PRICE_COURSE1=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_COURSE2=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_COURSE3=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_COURSE4=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_COURSE5=price_xxxxxxxxxxxxxxxx

# Site URL for redirects (production)
NEXT_PUBLIC_SITE_URL=https://symmetrix.dev

# Optional: Backend API for course fulfillment
# BACKEND_API_URL=https://api.yourdomain.com
# BACKEND_API_KEY=your-secret-api-key

# AI assistant (server-side only; never expose this key in the HTML)
# GEMINI_API_KEY=replace_with_rotated_gemini_key
# GEMINI_MODEL=gemini-3.6-flash